# Nashriyot AI — созламалар намунаси.
# Нусха олинг:  cp .env.example .env   ва қийматларни тўлдиринг.
# .env файли Git'га қўшилмайди (.gitignore).

# Telegram бот токени (@BotFather). Бўш қолса — demo режим, Telegram уланмайди.
BOT_TOKEN=

# OpenAI API калити. Бўш қолса — агентлар қоидалар асосида (AI'сиз) ишлайди.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Оддий матнли буйруқлар қайси двигателга боради:
#   rules   — калит сўзлар асосидаги координатор (1-версия)
#   agentic — AI асбобларни ўзи чақиради, жараён базада сақланади (2-версия, /ai ҳар доим ишлайди)
AGENT_ENGINE=rules

# Рухсат этилган Telegram ID'лар (вергул билан). ID'ни @userinfobot орқали билиш мумкин.
DIRECTOR_IDS=
STAFF_IDS=
VIEWER_IDS=

# База. Маҳаллий синов: SQLite. Серверда: PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./data/nashriyot.db
# DATABASE_URL=postgresql+asyncpg://nashriyot:ПАРОЛЬ@db:5432/nashriyot

# Docker Compose'даги PostgreSQL пароли
POSTGRES_PASSWORD=change-me

# REST API (/api/*) учун токен. Бўш қолса — /api ёпиқ, фақат /health ишлайди.
API_TOKEN=
API_PORT=8000

TIMEZONE=Asia/Tashkent
DAILY_REPORT_HOUR=19
REMINDER_HOURS_BEFORE=24
SCHEDULER_INTERVAL_SECONDS=60
LOG_LEVEL=INFO

# ---------------- Сотув агенти (мижозларга жавоб беради) ----------------
SALES_ENABLED=true
SALES_SHOP_NAME="Jihan Jan Jasur Nam Tour"
# Мижоз тилини агент ўзи аниқлайди (uz, uzc, tr, ru). Бу — биринчи хабардан олдинги тил.
SALES_DEFAULT_LANGUAGE=uz
# Каталог: cp sales_catalog.example.json sales_catalog.json ва тўлдиринг.
SALES_CATALOG_PATH=sales_catalog.json
# true — нашриёт реестридаги нархи бор китоблар ҳам сотилади.
SALES_CATALOG_FROM_BOOKS=false
# Янги буюртма ва «менежер керак» хабарлари кимга келади (Telegram ID). Бўш — раҳбарларга.
SALES_MANAGER_IDS=

# Мижозлар учун алоҳида Telegram бот (@BotFather'да иккинчи бот).
SALES_BOT_TOKEN=

# Meta: Instagram Direct, WhatsApp Cloud API, Messenger → webhook: https://ДОМЕН/webhooks/meta
META_VERIFY_TOKEN=
META_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
MESSENGER_PAGE_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Телефон қўнғироқлари: Twilio → Voice webhook: https://ДОМЕН/webhooks/twilio/voice (POST)
TWILIO_AUTH_TOKEN=
SALES_PUBLIC_BASE_URL=
SALES_VOICE_STT_LANGUAGE=uz-UZ
SALES_VOICE_TTS_LANGUAGE=tr-TR
SALES_VOICE_NAME=

# ---------------- Сотув агенти: тўлиқ версия ----------------
# Мижоз юборган паспорт, PDF, расм ва овозли хабарлар шу ерда сақланади
SALES_FILES_DIR=data/lead_files
SALES_MAX_FILE_MB=20
# Овозли хабарни матнга айлантириш (OPENAI_API_KEY керак)
SALES_STT_MODEL=whisper-1
# Аризани тугатмаган мижозга неча соатдан кейин эслатма (Instagram/WhatsApp'да 24 соатдан кам бўлиши керак)
SALES_REMINDER_HOURS=20
# Олдиндан тўлов: card | payme | click | link | none
SALES_PAYMENT_PROVIDER=card
SALES_PAYMENT_CARD=
# 1 доллар неча сўм (Payme/Click ҳаволаси учун, нархлар долларда бўлгани учун)
SALES_USD_RATE=
PAYME_MERCHANT_ID=
PAYME_ACCOUNT_FIELD=order_id
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
SALES_PAYMENT_LINK_TEMPLATE=
# Google Sheets: Apps Script веб-иловаси манзили (README'га қаранг)
SALES_SHEETS_WEBHOOK_URL=

# Захира нусха: python -m app.main backup (Google Drive папкасини кўрсатиш мумкин)
BACKUP_DIR=data/backups
BACKUP_KEEP=14

# Bilimlar bazasi (konsultantlar tasdiqlagan savol-javoblar) va Instagram izohlari: intent | all | off
SALES_FAQ_PATH=sales_faq.json
SALES_COMMENT_MODE=intent

# ---------------- Шахсий маълумотлар ҳимояси ----------------
# Мижоз файлларини дискда шифрлаш калити. install.bat ўзи яратади.
# Калитни йўқотсангиз, файлларни очиб бўлмайди: уни алоҳида жойда (қоғозда ёки сейфда) сақланг.
SALES_FILES_KEY=
# Мижоз охирги марта ёзгандан неча кун кейин унинг файллари ўчирилади
SALES_FILE_RETENTION_DAYS=90
# Биринчи ҳужжатдан олдин мижоздан розилик сўраш
SALES_CONSENT_REQUIRED=true
